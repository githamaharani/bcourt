<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1440.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bcourt.controller.DashboardKasirController"
            style="-fx-background-color: #FAF5F1;">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="245.0" spacing="0.0"
              style="-fx-background-color: white; -fx-border-color: #EADFD8; -fx-border-width: 0 1 0 0;">

            <padding>
                <Insets top="28" right="18" bottom="22" left="18"/>
            </padding>

            <VBox spacing="3">
                <Label text="🏸  B-Court"
                       style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #F15A00;"/>
                <Label text="       Court Rental System"
                       style="-fx-font-size: 11px; -fx-text-fill: #8B6A59;"/>
            </VBox>

            <Region prefHeight="34" minHeight="34"/>

            <Label text="MENU PELAYANAN"
                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #A58B7D; -fx-padding: 0 0 10 8;"/>

            <Button text="▦   Beranda Kasir"
                    onAction="#showDashboard"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: #FFF0E7; -fx-text-fill: #F15A00; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 13; -fx-alignment: CENTER_LEFT;"/>

            <Button text="＋   Transaksi Baru"
                    onAction="#openTransactions"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: transparent; -fx-text-fill: #542A16; -fx-font-size: 14px; -fx-background-radius: 13; -fx-alignment: CENTER_LEFT;"/>

            <Button text="▤   Pembayaran"
                    onAction="#openPayments"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: transparent; -fx-text-fill: #542A16; -fx-font-size: 14px; -fx-background-radius: 13; -fx-alignment: CENTER_LEFT;"/>

            <Button text="▦   Jadwal Lapangan"
                    onAction="#openSchedule"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: transparent; -fx-text-fill: #542A16; -fx-font-size: 14px; -fx-background-radius: 13; -fx-alignment: CENTER_LEFT;"/>

            <Button text="◷   Riwayat Transaksi"
                    onAction="#openHistory"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: transparent; -fx-text-fill: #542A16; -fx-font-size: 14px; -fx-background-radius: 13; -fx-alignment: CENTER_LEFT;"/>

            <Region prefHeight="20" minHeight="20"/>

            <Separator/>

            <Label text="AKUN"
                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #A58B7D; -fx-padding: 14 0 8 8;"/>

            <Button text="♙   Profil Saya"
                    onAction="#openProfile"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: transparent; -fx-text-fill: #542A16; -fx-font-size: 14px; -fx-background-radius: 13; -fx-alignment: CENTER_LEFT;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>

            <Button text="⇥   Logout"
                    onAction="#logout"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: transparent; -fx-text-fill: #E14D32; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
    </left>

    <!-- KONTEN UTAMA -->
    <center>
        <VBox spacing="20">

            <padding>
                <Insets top="28" right="30" bottom="28" left="30"/>
            </padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12">

                <VBox spacing="4">
                    <Label text="Meja Kasir"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <Label text="Layani pelanggan dan proses penyewaan lapangan B-Court."
                           style="-fx-font-size: 13px; -fx-text-fill: #765D50;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox spacing="2"
                      style="-fx-background-color: white; -fx-background-radius: 24; -fx-padding: 10 20 10 20;">

                    <Label text="Kasir B-Court"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <Label text="Petugas Pelayanan"
                           style="-fx-font-size: 11px; -fx-text-fill: #8B6A59;"/>
                </VBox>
            </HBox>

            <!-- RINGKASAN AKTIVITAS KASIR -->
            <GridPane hgap="14" vgap="14">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0" spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18;">

                    <Label text="Transaksi Dilayani"
                           style="-fx-font-size: 13px; -fx-text-fill: #765D50;"/>

                    <Label fx:id="totalRentalLabel"
                           text="0 Transaksi"
                           style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <Label text="Jumlah transaksi hari ini"
                           style="-fx-font-size: 12px; -fx-text-fill: #8B6A59;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18;">

                    <Label text="Pembayaran Tercatat"
                           style="-fx-font-size: 13px; -fx-text-fill: #765D50;"/>

                    <Label fx:id="revenueLabel"
                           text="Rp0"
                           style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <Label text="Ringkasan pembayaran kasir"
                           style="-fx-font-size: 12px; -fx-text-fill: #159447;"/>
                </VBox>

                <VBox GridPane.columnIndex="2" spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18;">

                    <Label text="Belum Dibayar"
                           style="-fx-font-size: 13px; -fx-text-fill: #765D50;"/>

                    <Label fx:id="pendingPaymentLabel"
                           text="0 Transaksi"
                           style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <Label text="Transaksi pelanggan"
                           style="-fx-font-size: 12px; -fx-text-fill: #C27A16;"/>
                </VBox>

                <VBox GridPane.columnIndex="3" spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18;">

                    <Label text="Lapangan Tersedia"
                           style="-fx-font-size: 13px; -fx-text-fill: #765D50;"/>

                    <Label fx:id="availableCourtLabel"
                           text="0 Lapangan"
                           style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <Label text="Informasi ketersediaan"
                           style="-fx-font-size: 12px; -fx-text-fill: #159447;"/>
                </VBox>
            </GridPane>

            <!-- TRANSAKSI DAN PELAYANAN -->
            <GridPane hgap="16" vgap="16">

                <columnConstraints>
                    <ColumnConstraints percentWidth="62"/>
                    <ColumnConstraints percentWidth="38"/>
                </columnConstraints>

                <!-- DAFTAR TRANSAKSI -->
                <VBox GridPane.columnIndex="0" spacing="14"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="4">
                            <Label text="Transaksi Pelanggan"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                            <Label text="Daftar pelanggan yang dilayani kasir"
                                   style="-fx-font-size: 12px; -fx-text-fill: #80695D;"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Lihat Semua →"
                                onAction="#openHistory"
                                style="-fx-background-color: transparent; -fx-text-fill: #F15A00; -fx-font-weight: bold;"/>
                    </HBox>

                    <TableView fx:id="recentRentalTable"
                               prefHeight="260"
                               VBox.vgrow="ALWAYS">

                        <columns>
                            <TableColumn fx:id="codeColumn" text="Kode" prefWidth="90"/>
                            <TableColumn fx:id="customerColumn" text="Pelanggan" prefWidth="125"/>
                            <TableColumn fx:id="courtColumn" text="Lapangan" prefWidth="95"/>
                            <TableColumn fx:id="timeColumn" text="Waktu" prefWidth="105"/>
                            <TableColumn fx:id="amountColumn" text="Total" prefWidth="100"/>
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="85"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- AKSI KASIR -->
                <VBox GridPane.columnIndex="1" spacing="14"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 20;">

                    <Label text="Mulai Pelayanan"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <Label text="Pilih tindakan untuk melayani pelanggan"
                           style="-fx-font-size: 12px; -fx-text-fill: #80695D;"/>

                    <Button text="＋  Transaksi Penyewaan Baru"
                            onAction="#createRental"
                            maxWidth="Infinity"
                            prefHeight="52"
                            style="-fx-background-color: #F15A00; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 13;"/>

                    <Button text="▦  Periksa Jadwal Lapangan"
                            onAction="#openSchedule"
                            maxWidth="Infinity"
                            prefHeight="52"
                            style="-fx-background-color: #FFF0E7; -fx-text-fill: #542A16; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 13;"/>

                    <Button text="Rp  Catat Pembayaran"
                            onAction="#openPayments"
                            maxWidth="Infinity"
                            prefHeight="52"
                            style="-fx-background-color: #FFF0E7; -fx-text-fill: #542A16; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 13;"/>

                    <Separator/>

                    <Label text="Alur Pelayanan"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <Label text="1. Pilih lapangan dan jadwal"
                           style="-fx-font-size: 12px; -fx-text-fill: #765D50;"/>

                    <Label text="2. Masukkan data pelanggan"
                           style="-fx-font-size: 12px; -fx-text-fill: #765D50;"/>

                    <Label text="3. Hitung total penyewaan"
                           style="-fx-font-size: 12px; -fx-text-fill: #765D50;"/>

                    <Label text="4. Catat pembayaran pelanggan"
                           style="-fx-font-size: 12px; -fx-text-fill: #765D50;"/>

                    <Label text="5. Berikan bukti transaksi"
                           style="-fx-font-size: 12px; -fx-text-fill: #765D50;"/>
                </VBox>
            </GridPane>

            <Label fx:id="feedbackLabel"
                   text="Selamat bekerja. Siap melayani pelanggan B-Court."
                   wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #80695D;"/>

        </VBox>
    </center>
</BorderPane>
