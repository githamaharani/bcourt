<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bcourt.controller.PembayaranKasirController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #FAF5F1;">

    <top>
        <VBox spacing="10" style="-fx-background-color: white;">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Kembali"
                        onAction="#backToDashboard"
                        style="-fx-background-color: #FFF0E7; -fx-text-fill: #F15A00; -fx-background-radius: 8; -fx-padding: 10 16;"/>

                <VBox spacing="4">
                    <Label text="Pencatatan Pembayaran"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                    <Label text="Catat pembayaran pelanggan melalui Tunai atau QRIS."
                           style="-fx-font-size: 13px; -fx-text-fill: #80695D;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #FAF5F1; -fx-background-color: transparent;">

            <VBox spacing="20">
                <padding>
                    <Insets top="25" right="25" bottom="25" left="25"/>
                </padding>

                <!-- RINGKASAN -->
                <HBox spacing="15">
                    <VBox spacing="7" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18;">
                        <Label text="Total Transaksi"
                               style="-fx-text-fill: #777777;"/>
                        <Label fx:id="totalPaymentLabel"
                               text="0 Transaksi"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                    </VBox>

                    <VBox spacing="7" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18;">
                        <Label text="Menunggu Pembayaran"
                               style="-fx-text-fill: #777777;"/>
                        <Label fx:id="unpaidPaymentLabel"
                               text="0 Transaksi"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #D18B25;"/>
                    </VBox>
                </HBox>

                <!-- DAFTAR TRANSAKSI -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">

                    <Label text="Daftar Transaksi Pelanggan"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <Label text="Pilih transaksi yang ingin dicatat pembayarannya."
                           style="-fx-text-fill: #80695D; -fx-font-size: 12px;"/>

                    <TableView fx:id="paymentTable" prefHeight="250">
                        <columns>
                            <TableColumn fx:id="codeColumn"
                                         text="Kode Transaksi"
                                         prefWidth="180"/>
                            <TableColumn fx:id="customerColumn"
                                         text="Pelanggan"
                                         prefWidth="180"/>
                            <TableColumn fx:id="courtColumn"
                                         text="Lapangan"
                                         prefWidth="180"/>
                            <TableColumn fx:id="dateColumn"
                                         text="Tanggal"
                                         prefWidth="140"/>
                            <TableColumn fx:id="statusColumn"
                                         text="Status"
                                         prefWidth="180"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- DETAIL PEMBAYARAN -->
                <VBox spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">

                    <Label text="Detail Pembayaran"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <GridPane hgap="15" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Kode Transaksi"
                               GridPane.rowIndex="0"/>
                        <TextField fx:id="codeField"
                                   editable="false"
                                   promptText="Pilih transaksi terlebih dahulu"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                        <Label text="Nama Pelanggan"
                               GridPane.rowIndex="1"/>
                        <TextField fx:id="customerField"
                                   editable="false"
                                   promptText="Nama pelanggan"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                        <Label text="Lapangan"
                               GridPane.rowIndex="2"/>
                        <TextField fx:id="courtField"
                                   editable="false"
                                   promptText="Lapangan"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2"/>

                        <Label text="Metode Pembayaran"
                               GridPane.rowIndex="3"/>
                        <ComboBox fx:id="methodCombo"
                                  promptText="Pilih metode pembayaran"
                                  maxWidth="Infinity"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="3"/>
                    </GridPane>

                    <HBox alignment="CENTER_LEFT"
                          style="-fx-background-color: #FFF5E8; -fx-background-radius: 10; -fx-padding: 13;">
                        <Label text="Informasi: Pembayaran yang dicatat akan menunggu verifikasi Admin."
                               wrapText="true"
                               style="-fx-text-fill: #9B681C; -fx-font-size: 12px;"/>
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button text="Reset Pilihan"
                                onAction="#resetSelection"
                                prefHeight="42"
                                style="-fx-background-color: #F1E8E2; -fx-text-fill: #542A16; -fx-background-radius: 8; -fx-padding: 10 18;"/>

                        <Button text="Catat Pembayaran"
                                onAction="#confirmPayment"
                                prefHeight="42"
                                style="-fx-background-color: #F15A00; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;"/>
                    </HBox>

                    <Label fx:id="feedbackLabel"
                           text="Pilih transaksi untuk memulai pencatatan pembayaran."
                           wrapText="true"
                           style="-fx-text-fill: #80695D; -fx-font-size: 12px;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
