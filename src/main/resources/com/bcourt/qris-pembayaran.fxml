<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bcourt.controller.QrisKasirController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            style="-fx-background-color: #FAF5F1;">

    <content>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              style="-fx-background-color: #FAF5F1;">

            <padding>
                <Insets top="30" right="25" bottom="30" left="25"/>
            </padding>

            <Label text="PEMBAYARAN QRIS"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

            <Label text="B-Court Badminton"
                   style="-fx-font-size: 14px; -fx-text-fill: #80695D;"/>

            <VBox alignment="CENTER"
                  spacing="18"
                  maxWidth="500"
                  style="-fx-background-color: white; -fx-background-radius: 18;">

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>

                <Label text="TOTAL PEMBAYARAN"
                       style="-fx-font-size: 14px; -fx-text-fill: #80695D;"/>

                <Label fx:id="totalLabel"
                       text="Rp0"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #F15A00;"/>

                <ImageView fx:id="qrImageView"
                           fitWidth="230"
                           fitHeight="230"
                           preserveRatio="true"/>

                <Label text="Pindai kode QR di atas"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                <Label text="Kode QR ini digunakan untuk simulasi pembayaran B-Court."
                       wrapText="true"
                       maxWidth="350"
                       style="-fx-font-size: 12px; -fx-text-fill: #80695D;"
                       textAlignment="CENTER"/>

                <Region prefHeight="5"/>

                <VBox spacing="8"
                      style="-fx-background-color: #FFF5ED; -fx-background-radius: 10; -fx-padding: 15;"
                      maxWidth="350">

                    <HBox spacing="10">
                        <Label text="Kode Transaksi:"
                               style="-fx-text-fill: #80695D;"/>
                        <Label fx:id="codeLabel"
                               text="-"
                               style="-fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Pelanggan:"
                               style="-fx-text-fill: #80695D;"/>
                        <Label fx:id="customerLabel"
                               text="-"
                               style="-fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                    </HBox>
                </VBox>

                <Label fx:id="statusLabel"
                       text="Menunggu konfirmasi pembayaran"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>

                <Button text="Konfirmasi Pembayaran (Simulasi)"
                        onAction="#confirmPayment"
                        maxWidth="350"
                        prefHeight="45"
                        style="-fx-background-color: #F15A00; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"/>

                <Button text="Kembali ke Dashboard"
                        onAction="#backToDashboard"
                        maxWidth="350"
                        prefHeight="42"
                        style="-fx-background-color: #F1EAE5; -fx-text-fill: #542A16; -fx-font-weight: bold; -fx-background-radius: 10;"/>

            </VBox>
        </VBox>
    </content>
</ScrollPane>
