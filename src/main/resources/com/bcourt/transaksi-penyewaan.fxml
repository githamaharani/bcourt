<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1440.0" prefHeight="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bcourt.controller.TransaksiKasirController"
            style="-fx-background-color: #FAF5F1;">

    <top>
        <VBox spacing="12" style="-fx-background-color: white;">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Kembali"
                        onAction="#backToDashboard"
                        style="-fx-background-color: #FFF0E7; -fx-text-fill: #F15A00; -fx-font-weight: bold; -fx-background-radius: 10;"/>

                <VBox spacing="4">
                    <Label text="Transaksi Penyewaan"
                           style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                    <Label text="Pelayanan penyewaan lapangan B-Court"
                           style="-fx-text-fill: #80695D; -fx-font-size: 13px;"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER" spacing="12">
                <Label fx:id="step1Label" text="1. Pilih Lapangan"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #F15A00;"/>
                <Label text="────────" style="-fx-text-fill: #D9C7BC;"/>
                <Label fx:id="step2Label" text="2. Peralatan Opsional"
                       style="-fx-font-size: 13px; -fx-text-fill: #A58B7D;"/>
                <Label text="────────" style="-fx-text-fill: #D9C7BC;"/>
                <Label fx:id="step3Label" text="3. Konfirmasi"
                       style="-fx-font-size: 13px; -fx-text-fill: #A58B7D;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #FAF5F1; -fx-background-color: transparent;">

            <VBox spacing="20">
                <padding>
                    <Insets top="25" right="35" bottom="30" left="35"/>
                </padding>

                <!-- TAHAP 1 -->
                <VBox fx:id="step1Box" spacing="18"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 25;">

                    <VBox spacing="5">
                        <Label text="Pilih Lapangan dan Jadwal"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                        <Label text="Masukkan informasi pelanggan dan tentukan jadwal penyewaan."
                               style="-fx-text-fill: #80695D;"/>
                    </VBox>

                    <Separator/>

                    <Label text="Informasi Pelanggan"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <GridPane hgap="18" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <VBox spacing="7" GridPane.columnIndex="0">
                            <Label text="Nama Pelanggan"/>
                            <TextField fx:id="customerField"
                                       promptText="Masukkan nama pelanggan"
                                       prefHeight="42"/>
                        </VBox>

                        <VBox spacing="7" GridPane.columnIndex="1">
                            <Label text="Nomor WhatsApp"/>
                            <TextField fx:id="phoneField"
                                       promptText="Contoh: 08xxxxxxxxxx"
                                       prefHeight="42"/>
                        </VBox>
                    </GridPane>

                    <Separator/>

                    <Label text="Pilihan Lapangan"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <GridPane hgap="18" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <VBox spacing="8" GridPane.columnIndex="0">
                            <Label text="Nomor Lapangan"/>
                            <ComboBox fx:id="courtCombo"
                                      promptText="Pilih lapangan"
                                      maxWidth="Infinity"
                                      prefHeight="42"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="1">
                            <Label text="Jenis Permainan"/>
                            <ComboBox fx:id="gameTypeCombo"
                                      promptText="Pilih jenis permainan"
                                      maxWidth="Infinity"
                                      prefHeight="42"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Tanggal Penyewaan"/>
                            <DatePicker fx:id="datePicker"
                                        maxWidth="Infinity"
                                        prefHeight="42"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Jam Mulai"/>
                            <ComboBox fx:id="startTimeCombo"
                                      promptText="Pilih jam mulai"
                                      maxWidth="Infinity"
                                      prefHeight="42"/>
                        </VBox>

                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Jam Selesai"/>
                            <ComboBox fx:id="endTimeCombo"
                                      promptText="Pilih jam selesai"
                                      maxWidth="Infinity"
                                      prefHeight="42"/>
                        </VBox>
                    </GridPane>

                    <HBox alignment="CENTER_LEFT"
                          style="-fx-background-color: #FFF5ED; -fx-background-radius: 12; -fx-padding: 15;">
                        <VBox spacing="5">
                            <Label text="Harga Sewa per Jam"
                                   style="-fx-text-fill: #80695D;"/>
                            <Label fx:id="courtPriceLabel"
                                   text="Pilih jenis permainan"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F15A00;"/>
                        </VBox>
                    </HBox>

                    <TextArea fx:id="noteField"
                              promptText="Catatan tambahan (opsional)"
                              prefRowCount="2"
                              wrapText="true"/>

                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Lanjut Pilih Peralatan →"
                                onAction="#nextToEquipment"
                                prefHeight="45"
                                style="-fx-background-color: #F15A00; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                    </HBox>
                </VBox>

                <!-- TAHAP 2 -->
                <VBox fx:id="step2Box" spacing="18"
                      visible="false" managed="false"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 25;">

                    <VBox spacing="5">
                        <Label text="Peralatan Tambahan"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                        <Label text="Pelanggan dapat menambahkan peralatan. Tahap ini boleh dilewati."
                               style="-fx-text-fill: #80695D;"/>
                    </VBox>

                    <Separator/>

                    <VBox spacing="12"
                          style="-fx-background-color: #FFF8F3; -fx-background-radius: 14; -fx-padding: 18;">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <VBox spacing="5">
                                <Label text="🏸  Raket Badminton"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                                <Label text="Rp15.000 per buah"
                                       style="-fx-text-fill: #F15A00;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <CheckBox fx:id="racketCheck" text="Tambahkan"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Jumlah raket:"/>
                            <TextField fx:id="racketQtyField"
                                       text="1" prefWidth="75"
                                       promptText="Jumlah"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="12"
                          style="-fx-background-color: #FFF8F3; -fx-background-radius: 14; -fx-padding: 18;">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <VBox spacing="5">
                                <Label text="🏸  Shuttlecock"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                                <Label text="Rp25.000 per tabung"
                                       style="-fx-text-fill: #F15A00;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <CheckBox fx:id="shuttleCheck" text="Tambahkan"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Jumlah tabung:"/>
                            <TextField fx:id="shuttleQtyField"
                                       text="1" prefWidth="75"
                                       promptText="Jumlah"/>
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Button text="← Kembali"
                                onAction="#backToCourt"
                                prefHeight="43"
                                style="-fx-background-color: #FFF0E7; -fx-text-fill: #542A16; -fx-background-radius: 10;"/>

                        <Button text="Lewati Peralatan"
                                onAction="#skipEquipment"
                                prefHeight="43"
                                style="-fx-background-color: #F1EAE5; -fx-text-fill: #542A16; -fx-background-radius: 10;"/>

                        <Button text="Lanjut Konfirmasi →"
                                onAction="#nextToSummary"
                                prefHeight="43"
                                style="-fx-background-color: #F15A00; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                    </HBox>
                </VBox>

                <!-- TAHAP 3 -->
                <VBox fx:id="step3Box" spacing="18"
                      visible="false" managed="false"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 25;">

                    <VBox spacing="5">
                        <Label text="Konfirmasi Pesanan"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                        <Label text="Periksa kembali pesanan sebelum mencatat transaksi."
                               style="-fx-text-fill: #80695D;"/>
                    </VBox>

                    <Separator/>

                    <Label text="Ringkasan Penyewaan"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <GridPane hgap="15" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="35"/>
                            <ColumnConstraints percentWidth="65"/>
                        </columnConstraints>

                        <Label text="Nama Pelanggan" GridPane.rowIndex="0"/>
                        <Label fx:id="summaryCustomerLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Nomor WhatsApp" GridPane.rowIndex="1"/>
                        <Label fx:id="summaryPhoneLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Lapangan" GridPane.rowIndex="2"/>
                        <Label fx:id="summaryCourtLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Jenis Permainan" GridPane.rowIndex="3"/>
                        <Label fx:id="summaryGameLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Tanggal" GridPane.rowIndex="4"/>
                        <Label fx:id="summaryDateLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <Label text="Waktu" GridPane.rowIndex="5"/>
                        <Label fx:id="summaryTimeLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                        <Label text="Durasi" GridPane.rowIndex="6"/>
                        <Label fx:id="summaryDurationLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                    </GridPane>

                    <Separator/>

                    <Label text="Rincian Biaya"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <Label fx:id="courtCostLabel" text="Sewa lapangan: Rp0"/>
                    <Label fx:id="equipmentCostLabel" text="Peralatan: Rp0"/>

                    <HBox alignment="CENTER_LEFT"
                          style="-fx-background-color: #FFF0E7; -fx-background-radius: 12; -fx-padding: 16;">
                        <Label text="TOTAL PEMBAYARAN"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalCostLabel" text="Rp0"
                               style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #F15A00;"/>
                    </HBox>

                    <Separator/>

                    <Label text="Metode Pembayaran"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #542A16;"/>

                    <VBox spacing="10">
                        <RadioButton fx:id="cashRadio"
                                     text="Tunai - Dibayar langsung di lokasi"/>
                        <RadioButton fx:id="qrisRadio"
                                     text="QRIS - Pembayaran digital"/>
                    </VBox>

                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Button text="← Kembali"
                                onAction="#backToEquipment"
                                prefHeight="43"
                                style="-fx-background-color: #FFF0E7; -fx-text-fill: #542A16; -fx-background-radius: 10;"/>

                        <Button text="Simpan Transaksi"
                                onAction="#confirmRental"
                                prefHeight="43"
                                style="-fx-background-color: #F15A00; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                    </HBox>
                </VBox>

                <Label fx:id="feedbackLabel"
                       text="Silakan mulai proses penyewaan."
                       wrapText="true"
                       style="-fx-text-fill: #80695D; -fx-font-size: 12px;"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
