<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="680.0" prefWidth="1050.0" style="-fx-background-color: #3B2314;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Kartu Utama -->
      <HBox maxHeight="560.0" maxWidth="900.0" prefHeight="560.0" prefWidth="900.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20;">
         <children>
            <!-- PANEL KIRI: Branding & Ilustrasi -->
            <VBox prefHeight="560.0" prefWidth="420.0" spacing="18.0" style="-fx-background-color: #F6E6DC; -fx-background-radius: 20 0 0 20;">
               <padding>
                  <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
               </padding>
               <children>
                  <!-- NOTE FOTO 1: Isi gambar logo B-Court di Scene Builder (Properties -> Image) -->
                  <ImageView fx:id="imgLogo" fitWidth="210.0" pickOnBounds="true" preserveRatio="true" />

                  <Region prefHeight="4.0" maxWidth="48.0" minHeight="4.0" style="-fx-background-color: #EA580C; -fx-background-radius: 2;" />

                  <Label text="Book, Manage,
and Play" textFill="#2B1810">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>

                  <Label text="A simple and efficient system for badminton court rentals." textFill="#6E574B" wrapText="true">
                     <font>
                        <Font size="13.5" />
                     </font>
                  </Label>

                  <Region VBox.vgrow="ALWAYS" />

                  <!-- NOTE FOTO 2: Isi gambar ilustrasi raket/shuttlecock di bagian bawah panel kiri -->
                  <HBox alignment="CENTER">
                     <children>
                        <ImageView fx:id="imgIllustration" fitWidth="280.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- PANEL KANAN: Form Login -->
            <VBox alignment="CENTER_LEFT" prefHeight="560.0" prefWidth="480.0" spacing="16.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 0 20 20 0;">
               <padding>
                  <Insets bottom="40.0" left="44.0" right="44.0" top="40.0" />
               </padding>
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Selamat datang kembali!" textFill="#2B1810">
                           <font>
                              <Font name="System Bold" size="25.0" />
                           </font>
                        </Label>
                        <Label text="Masuk ke akun B-Court kamu untuk mulai reservasi." textFill="#7A6A60">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>

                  <Region prefHeight="3.0" prefWidth="392.0" style="-fx-background-color: #EA580C; -fx-background-radius: 2;" />

                  <!-- Input Username -->
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Username" textFill="#3B2314">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtUsername" prefHeight="42.0" promptText="Masukkan username" style="-fx-background-color: #F4ECE6; -fx-background-radius: 10; -fx-border-color: #E2D5CC; -fx-border-radius: 10; -fx-padding: 0 14 0 14; -fx-font-size: 13px;" />
                     </children>
                  </VBox>

                  <!-- Input Password -->
                  <VBox spacing="6.0">
                     <children>
                        <Label text="Password" textFill="#3B2314">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <StackPane alignment="CENTER_RIGHT">
                           <children>
                              <PasswordField fx:id="pwdPassword" prefHeight="42.0" promptText="Masukkan password" style="-fx-background-color: #F4ECE6; -fx-background-radius: 10; -fx-border-color: #E2D5CC; -fx-border-radius: 10; -fx-padding: 0 85 0 14; -fx-font-size: 13px;" />
                              <Button fx:id="btnTogglePassword" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #EA580C; -fx-font-weight: bold; -fx-font-size: 11.5px; -fx-cursor: hand;" text="Lihat sandi">
                                 <StackPane.margin>
                                    <Insets right="8.0" />
                                 </StackPane.margin>
                              </Button>
                           </children>
                        </StackPane>
                     </children>
                  </VBox>

                  <!-- Remember Me & Forgot Password -->
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <CheckBox fx:id="chkRememberMe" mnemonicParsing="false" text="Remember me" textFill="#5C493E">
                           <font>
                              <Font size="12.5" />
                           </font>
                        </CheckBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Hyperlink fx:id="lnkForgotPassword" style="-fx-text-fill: #EA580C; -fx-underline: false;" text="Forgot password?">
                           <font>
                              <Font name="System Bold" size="12.5" />
                           </font>
                        </Hyperlink>
                     </children>
                  </HBox>

                  <!-- Tombol Sign In -->
                  <Button fx:id="btnSignIn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="44.0" style="-fx-background-color: #EA580C; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10; -fx-cursor: hand;" text="Sign In">
                     <VBox.margin>
                        <Insets top="4.0" />
                     </VBox.margin>
                  </Button>

                  <!-- Link ke Register -->
                  <HBox alignment="CENTER" spacing="4.0">
                     <children>
                        <Label text="Don’t have an account?" textFill="#6E574B">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                        <Hyperlink fx:id="lnkRegister" style="-fx-text-fill: #EA580C; -fx-underline: false;" text="Register">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Hyperlink>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</StackPane>